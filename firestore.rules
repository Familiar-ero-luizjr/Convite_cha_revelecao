rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // O convite público lê e o painel atual grava somente este documento.
    // Não use este padrão para dados sensíveis.
    match /convites/principal {
      allow read, write: if true;
    }

    // Todo o restante do banco fica bloqueado.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
