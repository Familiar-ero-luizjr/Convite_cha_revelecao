rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /convites/principal {
      // O convite pode ser lido no GitHub Pages. Toda gravação passa pelo
      // Cloudflare Worker usando uma conta de serviço.
      allow read: if true;
      allow write: if false;

      match /{subcollection}/{document} {
        allow read, write: if false;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
